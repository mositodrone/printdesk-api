# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/printdesk?retryWrites=true&w=majority

# Must be at least 32 characters or the server refuses to start.
# Generate one with: node -p "require('crypto').randomBytes(48).toString('hex')"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
